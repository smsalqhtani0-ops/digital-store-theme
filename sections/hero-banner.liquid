{% comment %}
  Digital Store Theme — Hero Banner Section
  Salla Twilight | Customizable from Salla Dashboard
{% endcomment %}

<section
  id="hero-banner"
  class="hero-section bg-animated-gradient scan-lines"
  data-section-type="hero-banner"
  style="
    {% if section.settings.bg_image != blank %}
      --hero-bg-image: url('{{ section.settings.bg_image | img_url: 'master' }}');
    {% endif %}
    min-height: {{ section.settings.min_height | default: '100' }}vh;
  "
>
  <!-- Blob decorations -->
  <div class="blob blob-purple" style="top:-100px; inset-inline-end:-100px;"></div>
  <div class="blob blob-blue"   style="bottom:-50px; inset-inline-start:-80px;"></div>

  <!-- Particle canvas -->
  <canvas id="hero-particles" class="hero-particles-canvas" aria-hidden="true"></canvas>

  <div class="container hero-inner">

    <!-- Badge -->
    {% if section.settings.badge_text != blank %}
    <div class="hero-badge" data-animate="up" data-delay="100">
      <span class="badge-glow">
        <span class="dot"></span>
        {{ section.settings.badge_text }}
      </span>
    </div>
    {% endif %}

    <!-- Headline -->
    <h1 class="hero-title" data-animate="up" data-delay="200">
      {% if section.settings.title_line1 != blank %}
        <span class="hero-title-line">{{ section.settings.title_line1 }}</span>
      {% else %}
        <span class="hero-title-line">متجرك الرقمي</span>
      {% endif %}
      <br>
      <span class="text-gradient" id="hero-typing-target">
        {% if section.settings.title_line2 != blank %}
          {{ section.settings.title_line2 }}
        {% else %}
          الاحترافي
        {% endif %}
      </span>
    </h1>

    <!-- Sub-headline -->
    <p class="hero-subtitle" data-animate="up" data-delay="300">
      {{ section.settings.subtitle | default: 'اكتشف منتجات رقمية عالية الجودة — قوالب، إضافات، وأدوات تصميم احترافية جاهزة للتحميل الفوري.' }}
    </p>

    <!-- CTA Buttons -->
    <div class="hero-actions" data-animate="up" data-delay="400">
      <a
        href="{{ section.settings.cta_primary_url | default: '/collections' }}"
        class="btn btn-glow btn-lg"
        aria-label="{{ section.settings.cta_primary_text | default: 'تصفح المنتجات' }}"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
        {{ section.settings.cta_primary_text | default: 'تصفح المنتجات' }}
      </a>

      {% if section.settings.cta_secondary_url != blank %}
      <a
        href="{{ section.settings.cta_secondary_url }}"
        class="btn btn-secondary btn-lg"
      >
        {{ section.settings.cta_secondary_text | default: 'اعرف المزيد' }}
      </a>
      {% endif %}
    </div>

    <!-- Trust Indicators -->
    {% if section.settings.show_trust %}
    <div class="hero-trust" data-animate="up" data-delay="500">
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
        <span>{{ section.settings.trust_1 | default: 'تحميل فوري' }}</span>
      </div>
      <span class="trust-sep">•</span>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>{{ section.settings.trust_2 | default: 'دفع آمن 100%' }}</span>
      </div>
      <span class="trust-sep">•</span>
      <div class="trust-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <span>{{ section.settings.trust_3 | default: 'دعم فني 24/7' }}</span>
      </div>
    </div>
    {% endif %}

  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll-indicator" aria-hidden="true">
    <div class="scroll-mouse">
      <div class="scroll-wheel"></div>
    </div>
  </div>
</section>

<!-- ============ Styles ============ -->
<style>
.hero-section {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hero-particles-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.hero-inner {
  position: relative;
  z-index: 1;
  text-align: center;
  padding-block: clamp(6rem, 12vw, 10rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-6);
}

.hero-badge { margin-bottom: var(--space-2); }

.hero-title {
  font-size: clamp(2.5rem, 7vw, 5.5rem);
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  max-width: 900px;
}

.hero-title-line { display: block; }

/* Typing cursor effect */
#hero-typing-target {
  border-inline-end: 3px solid var(--color-purple-light);
  padding-inline-end: 4px;
  animation: blink 1s step-end infinite;
  display: inline;
}

.hero-subtitle {
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: var(--color-text-secondary);
  max-width: 600px;
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  gap: var(--space-4);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-2);
}

.hero-trust {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--space-4);
  padding: var(--space-3) var(--space-6);
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-full);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.trust-item svg { color: var(--color-purple-light); flex-shrink: 0; }
.trust-sep { color: var(--color-border); font-size: 1.2em; }

/* Scroll indicator */
.hero-scroll-indicator {
  position: absolute;
  bottom: var(--space-8);
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  animation: float 2s ease-in-out infinite;
}

.scroll-mouse {
  width: 26px;
  height: 40px;
  border: 2px solid rgba(255,255,255,0.3);
  border-radius: 13px;
  display: flex;
  justify-content: center;
  padding-top: 6px;
}

.scroll-wheel {
  width: 4px;
  height: 8px;
  background: var(--color-purple-light);
  border-radius: 2px;
  animation: scroll-wheel 2s ease-in-out infinite;
}

@keyframes scroll-wheel {
  0%   { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(12px); opacity: 0; }
}

@media (max-width: 768px) {
  .hero-trust { gap: var(--space-3); padding: var(--space-3); }
  .trust-sep { display: none; }
  .hero-trust { flex-direction: column; border-radius: var(--radius-xl); }
  .hero-actions { flex-direction: column; align-items: center; }
  .hero-actions .btn { width: 100%; max-width: 320px; }
}
</style>

<!-- ============ Schema ============ -->
{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "المحتوى الرئيسي"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "نص الشارة العلوية",
      "default": "✨ منتجات رقمية احترافية"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "العنوان — السطر الأول",
      "default": "متجرك الرقمي"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "العنوان — السطر الثاني (متحرك)",
      "default": "الاحترافي"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "النص التوضيحي",
      "default": "اكتشف منتجات رقمية عالية الجودة — قوالب، إضافات، وأدوات تصميم احترافية جاهزة للتحميل الفوري."
    },
    {
      "type": "header",
      "content": "أزرار CTA"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "نص الزر الأساسي",
      "default": "تصفح المنتجات"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "رابط الزر الأساسي"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "نص الزر الثانوي",
      "default": "اعرف المزيد"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "رابط الزر الثانوي"
    },
    {
      "type": "header",
      "content": "عناصر الثقة"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "إظهار عناصر الثقة",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "عنصر ثقة 1",
      "default": "تحميل فوري"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "عنصر ثقة 2",
      "default": "دفع آمن 100%"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "عنصر ثقة 3",
      "default": "دعم فني 24/7"
    },
    {
      "type": "header",
      "content": "الخلفية"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "صورة الخلفية (اختياري)"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "الارتفاع الأدنى (vh)",
      "min": 60,
      "max": 100,
      "step": 5,
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Hero"
    }
  ]
}
{% endschema %}
