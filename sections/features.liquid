{% comment %}
  Digital Store Theme — Features Section
  "لماذا تختارنا" — 4 Glass Cards with animated SVG icons
{% endcomment %}

<section id="features" class="section" data-section-type="features">
  <div class="container">

    <div class="section-header" data-animate="up">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'مميزاتنا' }}</span>
      <h2>{{ section.settings.title | default: 'لماذا تختار <span class="text-gradient">Digital Store</span>?' }}</h2>
      <div class="divider"></div>
      <p>{{ section.settings.subtitle | default: 'نقدم لك أفضل تجربة تسوق رقمية بأدوات متطورة وخدمة استثنائية' }}</p>
    </div>

    <div class="features-grid">

      {% for i in (1..4) %}
        {% assign title_key    = 'feature_' | append: i | append: '_title' %}
        {% assign text_key     = 'feature_' | append: i | append: '_text' %}
        {% assign icon_key     = 'feature_' | append: i | append: '_icon' %}

        <div class="feature-card glass-card card-glow-edge" data-animate="up" data-delay="{{ i | times: 100 }}">
          <div class="feature-icon-wrap">
            {% case section.settings[icon_key] | default: i %}
              {% when '1', 1 %}
                <!-- Instant Download -->
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="url(#grad1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#7C3AED"/>
                      <stop offset="100%" stop-color="#3B82F6"/>
                    </linearGradient>
                  </defs>
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
              {% when '2', 2 %}
                <!-- Secure Payment -->
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="url(#grad2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#7C3AED"/>
                      <stop offset="100%" stop-color="#3B82F6"/>
                    </linearGradient>
                  </defs>
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              {% when '3', 3 %}
                <!-- Quality -->
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="url(#grad3)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <linearGradient id="grad3" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#7C3AED"/>
                      <stop offset="100%" stop-color="#3B82F6"/>
                    </linearGradient>
                  </defs>
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              {% when '4', 4 %}
                <!-- Support -->
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="url(#grad4)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <defs>
                    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#7C3AED"/>
                      <stop offset="100%" stop-color="#3B82F6"/>
                    </linearGradient>
                  </defs>
                  <path d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
            {% endcase %}
          </div>

          <h3>
            {% case i %}
              {% when 1 %}{{ section.settings.feature_1_title | default: 'تحميل فوري' }}
              {% when 2 %}{{ section.settings.feature_2_title | default: 'دفع آمن' }}
              {% when 3 %}{{ section.settings.feature_3_title | default: 'جودة عالية' }}
              {% when 4 %}{{ section.settings.feature_4_title | default: 'دعم متواصل' }}
            {% endcase %}
          </h3>
          <p>
            {% case i %}
              {% when 1 %}{{ section.settings.feature_1_text | default: 'احصل على منتجاتك فور إتمام الدفع بدون انتظار أو تأخير.' }}
              {% when 2 %}{{ section.settings.feature_2_text | default: 'جميع عمليات الدفع مؤمنة بأعلى معايير التشفير الحديثة.' }}
              {% when 3 %}{{ section.settings.feature_3_text | default: 'منتجات مراجعة ومعتمدة من خبراء لضمان أعلى مستوى جودة.' }}
              {% when 4 %}{{ section.settings.feature_4_text | default: 'فريق دعم متخصص متاح على مدار الساعة للإجابة عن استفساراتك.' }}
            {% endcase %}
          </p>
        </div>
      {% endfor %}

    </div>
  </div>
</section>

<style>
.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
}

@media (max-width: 1200px) {
  .features-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .features-grid { grid-template-columns: 1fr; }
}
</style>

{% schema %}
{
  "name": "قسم المميزات",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "النص الصغير فوق العنوان",
      "default": "مميزاتنا"
    },
    {
      "type": "text",
      "id": "title",
      "label": "العنوان الرئيسي",
      "default": "لماذا تختارنا؟"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "النص التوضيحي",
      "default": "نقدم لك أفضل تجربة تسوق رقمية بأدوات متطورة وخدمة استثنائية"
    },
    { "type": "header", "content": "البطاقة الأولى" },
    { "type": "text", "id": "feature_1_title", "label": "العنوان", "default": "تحميل فوري" },
    { "type": "textarea", "id": "feature_1_text", "label": "النص", "default": "احصل على منتجاتك فور إتمام الدفع بدون انتظار أو تأخير." },
    { "type": "header", "content": "البطاقة الثانية" },
    { "type": "text", "id": "feature_2_title", "label": "العنوان", "default": "دفع آمن" },
    { "type": "textarea", "id": "feature_2_text", "label": "النص", "default": "جميع عمليات الدفع مؤمنة بأعلى معايير التشفير الحديثة." },
    { "type": "header", "content": "البطاقة الثالثة" },
    { "type": "text", "id": "feature_3_title", "label": "العنوان", "default": "جودة عالية" },
    { "type": "textarea", "id": "feature_3_text", "label": "النص", "default": "منتجات مراجعة ومعتمدة من خبراء لضمان أعلى مستوى جودة." },
    { "type": "header", "content": "البطاقة الرابعة" },
    { "type": "text", "id": "feature_4_title", "label": "العنوان", "default": "دعم متواصل" },
    { "type": "textarea", "id": "feature_4_text", "label": "النص", "default": "فريق دعم متخصص متاح على مدار الساعة للإجابة عن استفساراتك." }
  ],
  "presets": [
    { "name": "قسم المميزات", "category": "Content" }
  ]
}
{% endschema %}
