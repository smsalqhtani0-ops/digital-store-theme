{% comment %}
  Digital Store Theme — Homepage Template
  Salla Twilight Theme Engine
{% endcomment %}

<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ locale | dir | default: 'rtl' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0A0A0F">

  <title>{{ store.name }} — {{ page_title | default: 'متجر رقمي احترافي' }}</title>
  <meta name="description" content="{{ page_description | default: store.description }}">

  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Theme Stylesheets -->
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'glassmorphism.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'neon.css' | asset_url }}">

  {{ content_for_header }}
</head>
<body class="home-page">

  <!-- ===== HEADER ===== -->
  <header class="site-header" id="site-header" role="banner">
    <div class="container header-inner">

      <a href="/" class="site-logo" aria-label="{{ store.name }}">
        {% if store.logo %}
          <img src="{{ store.logo | img_url: '200x' }}" alt="{{ store.name }}" width="140" height="44">
        {% else %}
          <span class="text-gradient fw-black" style="font-size:1.5rem;">{{ store.name }}</span>
        {% endif %}
      </a>

      <nav class="site-nav" role="navigation" aria-label="القائمة الرئيسية">
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>

      <div class="header-actions">
        <salla-search class="header-search" aria-label="بحث"></salla-search>
        <salla-cart-icon class="header-cart" aria-label="سلة التسوق"></salla-cart-icon>
        <salla-user-menu class="header-user" aria-label="حسابي"></salla-user-menu>
      </div>

      <button class="mobile-menu-btn btn btn-ghost btn-sm" aria-label="فتح القائمة" id="mobile-menu-toggle">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="3" y1="6"  x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu glass-lg" id="mobile-menu" role="dialog" aria-label="القائمة" hidden>
    <nav>
      {% for link in linklists.main-menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>
  </div>

  <main id="main-content" role="main">

    <!-- ===== HERO ===== -->
    {% section 'hero-banner' %}

    <!-- ===== FEATURES ===== -->
    {% section 'features' %}

    <!-- ===== FEATURED PRODUCTS ===== -->
    <section id="featured-products" class="section">
      <div class="container">

        <div class="section-header" data-animate="up">
          <span class="eyebrow">مجموعتنا</span>
          <h2>المنتجات <span class="text-gradient">المميزة</span></h2>
          <div class="divider"></div>
          <p>اكتشف أفضل منتجاتنا الرقمية المختارة بعناية لك</p>
        </div>

        <!-- Filter Tabs -->
        <div class="tabs-glass products-tabs" role="tablist" data-animate="up" data-delay="100">
          <button class="tab-btn active" role="tab" data-filter="all">الكل</button>
          {% for category in collections %}
            <button class="tab-btn" role="tab" data-filter="{{ category.handle }}">{{ category.name }}</button>
          {% endfor %}
        </div>

        <!-- Products Grid -->
        <div class="products-grid grid-auto" id="products-container">
          {% for product in collections.all.products limit: 8 %}
            <div data-animate="up" data-delay="{{ forloop.index | times: 50 | at_most: 400 }}">
              {% render 'product-card', product: product %}
            </div>
          {% else %}
            <div class="glass-card text-center" style="grid-column:1/-1; padding:4rem;">
              <p>لا توجد منتجات حالياً. أضف منتجاتك من لوحة التحكم.</p>
            </div>
          {% endfor %}
        </div>

        <!-- View All -->
        <div class="text-center" style="margin-top:var(--space-10);" data-animate="up">
          <a href="/collections" class="btn btn-secondary btn-lg">
            عرض جميع المنتجات
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ===== STATS ===== -->
    <section id="stats" class="section-sm">
      <div class="container">
        <div class="stats-grid" data-animate="scale">
          <div class="stat-card gradient-border">
            <span class="stat-number" data-counter="{{ settings.stat_1_number | default: '5000' }}">0</span>
            <span class="stat-label">{{ settings.stat_1_label | default: 'عميل سعيد' }}</span>
          </div>
          <div class="stat-card gradient-border">
            <span class="stat-number" data-counter="{{ settings.stat_2_number | default: '200' }}">0</span>
            <span class="stat-label">{{ settings.stat_2_label | default: 'منتج رقمي' }}</span>
          </div>
          <div class="stat-card gradient-border">
            <span class="stat-number" data-counter="{{ settings.stat_3_number | default: '99' }}">0</span>
            <span class="stat-label">{{ settings.stat_3_label | default: '% رضا العملاء' }}</span>
          </div>
          <div class="stat-card gradient-border">
            <span class="stat-number" data-counter="{{ settings.stat_4_number | default: '24' }}">0</span>
            <span class="stat-label">{{ settings.stat_4_label | default: '/7 دعم فني' }}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TESTIMONIALS ===== -->
    <section id="testimonials" class="section">
      <div class="container">

        <div class="section-header" data-animate="up">
          <span class="eyebrow">آراء العملاء</span>
          <h2>ماذا يقول <span class="text-gradient">عملاؤنا</span></h2>
          <div class="divider"></div>
        </div>

        <div class="testimonials-slider" id="testimonials-slider" data-animate="up" data-delay="100">

          {% for review in store.reviews limit: 6 %}
          <div class="testimonial-card">
            <div class="stars" aria-label="تقييم {{ review.rating }} نجوم">
              {% for i in (1..5) %}
                <svg viewBox="0 0 20 20">
                  <path fill="{% if i <= review.rating %}#F59E0B{% else %}rgba(255,255,255,0.1){% endif %}"
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {% endfor %}
            </div>
            <p class="testimonial-text">{{ review.comment }}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">
                {% if review.customer.avatar %}
                  <img src="{{ review.customer.avatar }}" alt="{{ review.customer.name }}" loading="lazy">
                {% endif %}
              </div>
              <div class="testimonial-info">
                <h4>{{ review.customer.name }}</h4>
                <span>{{ review.created_at | date: '%d %B %Y' }}</span>
              </div>
            </div>
          </div>
          {% else %}
          <!-- Placeholder testimonials -->
          {% assign placeholder_testimonials = "منتجات رائعة وتحميل فوري! أنصح الجميع بالتسوق هنا.,تجربة تسوق ممتازة والدعم الفني متجاوب جداً.,جودة المنتجات تفوق توقعاتي، سأعود للشراء مرة أخرى بالتأكيد.,تصاميم احترافية بأسعار منافسة. شكراً لكم!" | split: "," %}
          {% assign placeholder_names = "أحمد المحمد,سارة العبدالله,محمد الحربي,نورة السالم" | split: "," %}
          {% for text in placeholder_testimonials %}
          <div class="testimonial-card">
            <div class="stars">
              {% for i in (1..5) %}<svg viewBox="0 0 20 20"><path fill="#F59E0B" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{% endfor %}
            </div>
            <p class="testimonial-text">{{ text }}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar" style="background:rgba(124,58,237,0.2);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem;">
                {{ placeholder_names[forloop.index0] | slice: 0, 1 }}
              </div>
              <div class="testimonial-info">
                <h4>{{ placeholder_names[forloop.index0] }}</h4>
                <span>عميل موثق</span>
              </div>
            </div>
          </div>
          {% endfor %}
          {% endfor %}

        </div>

        <!-- Slider Controls -->
        <div class="slider-controls" aria-label="تحكم في السلايدر">
          <button class="slider-btn" id="testimonials-prev" aria-label="السابق">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="slider-dots" id="testimonials-dots"></div>
          <button class="slider-btn" id="testimonials-next" aria-label="التالي">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>

      </div>
    </section>

    <!-- ===== NEWSLETTER ===== -->
    <section id="newsletter" class="section-sm">
      <div class="container">
        <div class="newsletter-section glass-purple gradient-border" data-animate="scale">
          <div class="newsletter-content">
            <span class="eyebrow">ابق على تواصل</span>
            <h2>اشترك في <span class="text-gradient">نشرتنا البريدية</span></h2>
            <p>احصل على أحدث المنتجات والعروض الحصرية مباشرة في بريدك</p>
            <form class="newsletter-form" onsubmit="handleNewsletterSubmit(event)">
              <input
                type="email"
                class="newsletter-input"
                placeholder="أدخل بريدك الإلكتروني..."
                required
                aria-label="البريد الإلكتروني"
                dir="ltr"
              >
              <button type="submit" class="btn btn-glow">اشترك الآن</button>
            </form>
          </div>
          <div class="newsletter-decoration" aria-hidden="true">
            <div class="blob blob-purple blob-sm" style="top:20%;right:10%;"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <div class="footer-grid">

        <div class="footer-brand">
          {% if store.logo %}
            <img src="{{ store.logo | img_url: '160x' }}" alt="{{ store.name }}" width="120" height="38">
          {% else %}
            <span class="text-gradient fw-black" style="font-size:1.4rem;">{{ store.name }}</span>
          {% endif %}
          <p>{{ settings.footer_description | default: 'متجرك الرقمي الأول للمنتجات والحلول الإبداعية الاحترافية.' }}</p>
          <div class="social-links" style="margin-top:var(--space-5);">
            {% if settings.social_twitter  != blank %}<a href="{{ settings.social_twitter }}"  class="social-link" aria-label="تويتر" rel="noopener">{% include 'icon-twitter' %}</a>{% endif %}
            {% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}" class="social-link" aria-label="انستغرام" rel="noopener">{% include 'icon-instagram' %}</a>{% endif %}
            {% if settings.social_snapchat  != blank %}<a href="{{ settings.social_snapchat }}"  class="social-link" aria-label="سناب شات" rel="noopener">{% include 'icon-snapchat' %}</a>{% endif %}
          </div>
        </div>

        <div class="footer-col">
          <h4>روابط سريعة</h4>
          <ul>
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/collections">المنتجات</a></li>
            <li><a href="/pages/about">من نحن</a></li>
            <li><a href="/pages/contact">تواصل معنا</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>الدعم</h4>
          <ul>
            <li><a href="/pages/faq">الأسئلة الشائعة</a></li>
            <li><a href="/pages/refund-policy">سياسة الاسترداد</a></li>
            <li><a href="/pages/privacy-policy">سياسة الخصوصية</a></li>
            <li><a href="/pages/terms">الشروط والأحكام</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>النشرة البريدية</h4>
          <p style="font-size:var(--font-size-sm); margin-bottom:var(--space-3);">اشترك لتصلك أحدث العروض</p>
          <div class="footer-newsletter">
            <form class="newsletter-form" onsubmit="handleNewsletterSubmit(event)">
              <input type="email" class="newsletter-input" placeholder="بريدك الإلكتروني" required dir="ltr" aria-label="البريد الإلكتروني">
              <button type="submit" class="btn btn-primary btn-sm">اشترك</button>
            </form>
          </div>
        </div>

      </div>

      <div class="footer-bottom">
        <p>© {{ 'now' | date: '%Y' }} {{ store.name }}. جميع الحقوق محفوظة.</p>
        <div class="footer-payments">
          <salla-payment-icons></salla-payment-icons>
        </div>
      </div>
    </div>
  </footer>

  <!-- ===== ADDITIONAL STYLES ===== -->
  <style>
  .home-page { padding-top: 0; }

  /* Stats grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  /* Testimonials slider */
  .testimonials-slider {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .slider-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    display: flex; align-items: center; justify-content: center;
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .slider-btn:hover {
    background: rgba(124,58,237,0.2);
    border-color: var(--color-purple);
    color: var(--color-purple-light);
  }

  .slider-dots { display: flex; gap: var(--space-2); }

  .slider-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .slider-dot.active {
    background: var(--color-purple);
    width: 24px;
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px rgba(124,58,237,0.6);
  }

  /* Products tabs */
  .products-tabs {
    margin-bottom: var(--space-8);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: var(--space-1);
  }
  .products-tabs::-webkit-scrollbar { display: none; }

  /* Newsletter section */
  .newsletter-section {
    padding: clamp(2.5rem, 5vw, 4rem);
    border-radius: var(--radius-2xl);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .newsletter-content {
    position: relative;
    z-index: 1;
    max-width: 560px;
    margin: 0 auto;
  }

  .newsletter-content h2 { font-size: clamp(1.5rem, 3vw, 2.5rem); margin-block: var(--space-3); }
  .newsletter-content p  { margin-bottom: var(--space-6); }

  .newsletter-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: calc(var(--z-sticky) + 1);
    padding: var(--space-6);
    border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
    transform: translateY(-100%);
    transition: transform var(--transition-base);
  }

  .mobile-menu:not([hidden]) { transform: translateY(0); display: block; }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-10);
  }

  .mobile-menu nav a {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text-secondary);
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border-light);
    transition: color var(--transition-fast);
  }

  .mobile-menu nav a:hover { color: var(--color-purple-light); }

  .mobile-menu-btn { display: none; }

  @media (max-width: 768px) {
    .mobile-menu-btn { display: flex; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .testimonials-slider { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .newsletter-section { padding: var(--space-6); }
  }
  </style>

  <!-- ===== SCRIPTS ===== -->
  <script src="{{ 'particles.js' | asset_url }}" defer></script>
  <script src="{{ 'counter.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_layout }}

</body>
</html>
