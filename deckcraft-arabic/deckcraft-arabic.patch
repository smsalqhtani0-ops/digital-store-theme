+++ b/crates/ui-egui/src/i18n/tests.rs
@@ -0,0 +1,63 @@
+//! Interface language tests. They read the tables directly: the layout hook is process-wide, and
+//! the other tests drive the interface by its English labels.
+
+use super::*;
+
+fn ar() -> &'static Table {
+    table(from_code("ar").expect("Arabic is registered"))
+}
+
+#[test]
+fn the_arabic_catalog_is_well_formed() {
+    let (entries, errors) = catalog::parse_entries(LANGUAGES[1].source);
+    assert!(errors.is_empty(), "{errors:#?}");
+    assert!(entries.len() > 1000, "the whole interface is translated");
+}
+
+#[test]
+fn locales_resolve_to_languages() {
+    for tag in ["ar", "ar-SA", "ar_EG.UTF-8", "AR-ma"] {
+        assert_eq!(from_tag(tag), from_code("ar"), "{tag}");
+    }
+    assert_eq!(from_tag("en-GB"), Some(0));
+    assert_eq!(from_tag("C"), Some(0));
+    assert_eq!(from_tag("qaa-QM"), None);
+    assert!(LANGUAGES[1].is_rtl() && !LANGUAGES[0].is_rtl());
+}
+
+#[test]
+fn labels_are_stored_in_display_order() {
+    let t = ar();
+    assert_eq!(&*t.shown["Save"], "حفظ");
+    assert_eq!(&*t.shown["Home"], "الرئيسية الصفحة");
+    assert_eq!(t.logical["Home"], "الصفحة الرئيسية");
+    assert_eq!(&*t.shown["Insert Table…"], "…جدول إدراج");
+}
+
+#[test]
+fn built_text_finds_its_template_and_translates_the_filled_in_value() {
+    let t = ar();
+    assert_eq!(t.fill("Go to slide 4").as_deref(), Some("4 الشريحة إلى الانتقال"));
+    assert_eq!(t.fill("On Click of Title").as_deref(), Some("العنوان على النقر عند"));
+    assert_eq!(t.fill("Exported deck.pdf").as_deref(), Some("deck.pdf إلى التصدير تم"));
+    assert_eq!(t.fill("Something new"), None);
+    // A template needs words of its own: `{pct}%` alone matches nothing.
+    assert_eq!(t.fill("50%"), None);
+}
+
+#[test]
+fn two_row_ribbon_labels_wrap_as_written_then_read_top_to_bottom() {
+    fn wrap(s: &str) -> Vec<&str> {
+        s.split('\n').collect()
+    }
+    assert_eq!(label_rows_in(1, "New\nSlide", wrap), ["شريحة", "جديدة"]);
+    assert_eq!(label_rows_in(0, "New\nSlide", wrap), ["New", "Slide"]);
+}
+
+#[test]
+fn positional_placeholders_keep_their_values_and_sentences_are_not_templates() {
+    let t = ar();
+    // `Slide {} of {}`: the slide number comes first when read right to left.
+    assert_eq!(t.fill("Slide 1 of 8").as_deref(), Some("8 من 1 الشريحة"));
+    assert_eq!(t.fill("Automatic follows the system, and menus and commands change but nothing else does here"), None);
+}
