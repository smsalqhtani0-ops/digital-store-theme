diff --git a/crates/ui-egui/examples/ui_shot.rs b/crates/ui-egui/examples/ui_shot.rs
new file mode 100644
index 0000000..ee0616f
--- /dev/null
+++ b/crates/ui-egui/examples/ui_shot.rs
@@ -0,0 +1,106 @@
+//! Headless screenshots of the whole DeckCraft window in an interface language, and a list of
+//! the interface text still drawn in English.
+//!
+//! ```sh
+//! cargo run -p deckcraft-ui-egui --example ui_shot -- ar /tmp/shots
+//! ```
+//!
+//! Writes `<tab>.png` for every ribbon tab, `file-<page>.png` for the File pages and
+//! `dialog-<id>.png` for the dialogs, over the sample deck, and prints each distinct drawn text
+//! that still has English words in it (`untranslated: …`).
+
+use std::collections::BTreeSet;
+
+use deckcraft_engine::Session;
+use deckcraft_ui_egui::{Services, SlideApp};
+use egui::vec2;
+use egui_kittest::Harness;
+
+const TABS: [&str; 10] = ["Home", "Insert", "Draw", "Design", "Transitions", "Animations", "Slide Show", "Record", "Review", "View"];
+const DIALOGS: &[&str] = &[
+    "about",
+    "altText",
+    "autocorrect",
+    "bullets",
+    "comment",
+    "export",
+    "find",
+    "gridOptions",
+    "hyperlink",
+    "outline",
+    "paragraph",
+    "pasteSpecial",
+    "preferences",
+    "replaceFonts",
+    "slideSize",
+    "spelling",
+    "table",
+    "tabs",
+    "zoom",
+];
+
+fn texts(shape: &egui::Shape, out: &mut Vec<String>) {
+    match shape {
+        egui::Shape::Text(t) => out.push(t.galley.text().to_string()),
+        egui::Shape::Vec(v) => v.iter().for_each(|s| texts(s, out)),
+        _ => {}
+    }
+}
+
+/// Does `s` still read as English (a word of two or more ASCII letters)?
+fn english(s: &str) -> bool {
+    s.split(|c: char| !c.is_ascii_alphabetic()).any(|w| w.len() >= 2)
+}
+
+fn shoot(h: &mut Harness<'_, SlideApp>, dir: &str, name: &str, seen: &mut BTreeSet<String>) {
+    h.run_steps(6);
+    let mut drawn = Vec::new();
+    for s in &h.output().shapes {
+        texts(&s.shape, &mut drawn);
+    }
+    seen.extend(drawn.into_iter().filter(|t| english(t)));
+    match h.render() {
+        Ok(img) => {
+            let path = format!("{dir}/{name}.png");
+            img.save(&path).unwrap_or_else(|e| panic!("{path}: {e}"));
+        }
+        Err(e) => eprintln!("{name}: {e}"),
+    }
+}
+
+fn main() {
+    let mut args = std::env::args().skip(1);
+    let lang = args.next().unwrap_or_else(|| "ar".into());
+    let dir = args.next().unwrap_or_else(|| ".".into());
+    std::fs::create_dir_all(&dir).expect("output folder");
+    let mut s = Session::new();
+    deckcraft_engine::sample::open_sample(&mut s).expect("sample deck");
+    let mut app = SlideApp::new(s, Services::default());
+    app.ui.language = lang;
+    let mut h = Harness::builder().with_size(vec2(1400.0, 860.0)).with_pixels_per_point(1.5).with_step_dt(1.0 / 60.0).wgpu().build_ui_state(
+        |ui, app: &mut SlideApp| {
+            app.logic(ui.ctx());
+            app.ui(ui);
+        },
+        app,
+    );
+    let mut seen = BTreeSet::new();
+    for tab in TABS {
+        h.state_mut().ui.tab = tab.into();
+        shoot(&mut h, &dir, &tab.replace(' ', "-").to_lowercase(), &mut seen);
+    }
+    h.state_mut().ui.tab = "Home".into();
+    for page in deckcraft_ui_egui::backstage::Page::ALL {
+        h.state_mut().open_backstage(page);
+        shoot(&mut h, &dir, &format!("file-{}", page.id()), &mut seen);
+    }
+    h.state_mut().backstage = None;
+    for id in DIALOGS {
+        h.state_mut().dialog = Some(deckcraft_ui_egui::dialogs::Dialog::new(id));
+        shoot(&mut h, &dir, &format!("dialog-{id}"), &mut seen);
+        h.state_mut().dialog = None;
+    }
+    for t in seen {
+        println!("untranslated: {t:?}");
+    }
+}
