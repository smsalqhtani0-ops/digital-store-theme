+                if ui.selectable_label(app.ui.language == crate::i18n::AUTO, auto).clicked() {
+                    app.ui.language = crate::i18n::AUTO.into();
+                }
+                for l in &crate::i18n::LANGUAGES {
+                    if ui.selectable_label(app.ui.language == l.code, l.name).clicked() {
+                        app.ui.language = l.code.into();
+                    }
