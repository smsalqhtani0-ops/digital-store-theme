 /// Height of the ribbon's content area.
 pub const RIBBON_H: f32 = 66.0;
 
+/// `x`, a position inside `rect` worked out for a left-to-right interface, on the side it goes in
+/// the interface's direction: mirrored across `rect` when the interface reads right to left.
+pub fn mirror_x(rect: Rect, x: f32) -> f32 {
+    if crate::i18n::is_rtl() { rect.min.x + rect.max.x - x } else { x }
+}
+
+/// A one-line label centred on `center`, its font made smaller (down to 7 pt) when the text is
+/// wider than `max_w`: a gallery tile's name, which may be longer in another language.
+pub fn fitted_text(p: &egui::Painter, center: egui::Pos2, label: &str, size: f32, max_w: f32, color: Color32) {
+    let w = p.layout_no_wrap(label.to_string(), theme::font(size), color).size().x;
+    let size = if w > max_w && w > 0.0 { (size * max_w / w).max(7.0) } else { size };
+    p.text(center, Align2::CENTER_CENTER, label, theme::font(size), color);
+}
+
+/// `r` (inside `outer`) mirrored like [`mirror_x`].
+pub fn mirror_rect(outer: Rect, r: Rect) -> Rect {
+    if crate::i18n::is_rtl() { Rect::from_min_max(pos2(mirror_x(outer, r.max.x), r.min.y), pos2(mirror_x(outer, r.min.x), r.max.y)) } else { r }
+}
+
+/// Text anchored at its start: left in a left-to-right interface, right in a right-to-left one.
+pub fn start_align(v: egui::Align) -> Align2 {
+    let h = if crate::i18n::is_rtl() { egui::Align::RIGHT } else { egui::Align::LEFT };
