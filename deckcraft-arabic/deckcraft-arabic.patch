+++ b/crates/ui-egui/src/i18n/mod.rs
@@ -0,0 +1,281 @@
+//! Interface languages. Strings in the code stay English: they are command names, tab ids and
+//! test labels as well as what is drawn. A catalog per language (`*.tsv`) maps them to display
+//! text, and the text layout hook (`vendor/epaint`, `set_ui_translator`) swaps it in when a
+//! label, button, menu, tooltip or painted string is laid out, so a label is measured and drawn
+//! in the same language. Typed text (`TextEdit`) and the slides themselves are never translated.
+//!
+//! Text that the code builds with `format!` is matched against the catalog's `{name}`
+//! templates: `On Click of Rectangle 3` finds `On Click of {name}`, and the filled-in value is
+//! translated too when the catalog has it.
+//!
+//! The `language` setting is `auto` by default: the interface follows the system's language
+//! (`DECKCRAFT_LANGUAGE`, then the platform's preferred languages) when there is a catalog for
+//! it, and English otherwise. File ▸ Account ▸ Interface language picks one by hand.
+//!
+//! Arabic reads right to left: its catalog is put in display order when it loads (see `rtl`),
+//! and the ribbon is laid out from the right ([`is_rtl`]).
+
+mod catalog;
+pub mod rtl;
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, OnceLock};
+
+/// The `language` setting that follows the system.
+pub const AUTO: &str = "auto";
+
+/// One supported interface language.
+pub struct Lang {
+    /// BCP 47 code, lowercase; also the `language` setting's value.
+    pub code: &'static str,
+    /// The language's name in itself, shown in the language list.
+    pub name: &'static str,
+    /// Catalog file contents (empty for the built-in English).
+    source: &'static str,
+}
+
+/// The registry. English first: it is the fallback and the source language.
+pub static LANGUAGES: [Lang; 2] = [
+    Lang { code: "en", name: "English", source: "" },
+    // Arabic (Modern Standard); `ar`, `ar-SA`, `ar_EG.UTF-8` … resolve here.
+    Lang { code: "ar", name: "العربية", source: include_str!("ar.tsv") },
+];
+
+impl Lang {
+    /// Is the language written right to left (its own name is)?
+    pub fn is_rtl(&self) -> bool {
+        self.name.chars().any(rtl::is_rtl_char)
+    }
+}
+
+/// A `{name}` template from the catalog: its literal pieces around the placeholders.
+struct Template {
+    /// `pieces.len() == names.len() + 1`.
+    pieces: Vec<String>,
+    names: Vec<String>,
+    /// The translation in display order, placeholders still in it.
+    shown: String,
+}
+
+/// A loaded catalog.
+#[derive(Default)]
+struct Table {
+    /// English → translation as written (logical order).
+    logical: HashMap<String, String>,
+    /// English → translation in display order.
+    shown: HashMap<String, Arc<str>>,
+    templates: Vec<Template>,
+    rtl: bool,
+}
+
+/// `text` with its positional `{}` placeholders numbered in order (`{0}`, `{1}` …), so they
+/// keep their values once a right-to-left translation is put in display order.
+fn number_positional(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut parts = text.split("{}");
+    out.push_str(parts.next().unwrap_or_default());
+    for (i, part) in parts.enumerate() {
+        out.push_str(&format!("{{{i}}}"));
+        out.push_str(part);
+    }
+    out
+}
+
+/// The literal pieces and placeholder names of `text` (`{name}`), or `None` without any.
+fn split_template(text: &str) -> Option<(Vec<String>, Vec<String>)> {
+    let mut pieces = Vec::new();
+    let mut names = Vec::new();
+    let mut rest = text;
+    while let Some((before, after_open)) = rest.split_once('{') {
+        let Some((name, after_close)) = after_open.split_once('}') else { break };
+        pieces.push(before.to_string());
+        names.push(name.to_string());
+        rest = after_close;
+    }
+    if names.is_empty() {
+        return None;
+    }
+    pieces.push(rest.to_string());
+    Some((pieces, names))
+}
+
+impl Table {
+    fn load(lang: &Lang) -> Table {
+        let (entries, errors) = catalog::parse_entries(lang.source);
+        for error in errors {
+            log::warn!("{} interface catalog: {error}; that entry shows in English", lang.code);
+        }
+        let rtl = lang.is_rtl();
+        let mut table = Table { rtl, ..Table::default() };
+        for e in entries.into_iter().filter(|e| e.context.is_empty()) {
+            let numbered = number_positional(&e.translation);
+            let shown = if rtl { rtl::display_order(&numbered) } else { numbered };
+            if let Some((pieces, names)) = split_template(&number_positional(&e.source)) {
+                // A template needs words of its own: `{n}%` or `{a}{b}` would match anything.
+                let letters: usize = pieces.iter().map(|p| p.chars().filter(|c| c.is_alphabetic()).count()).sum();
+                if letters >= 2 {
+                    table.templates.push(Template { pieces, names, shown: shown.clone() });
+                }
+            }
+            table.shown.insert(e.source.clone(), Arc::from(shown));
+            table.logical.insert(e.source, e.translation);
+        }
+        // Longest literal first, so `Slide {n} of {total}` wins over `{a} of {b}`.
+        table.templates.sort_by_key(|t| std::cmp::Reverse(t.pieces.iter().map(String::len).sum::<usize>()));
+        table
+    }
+
+    /// `text` filled into a template, when one matches it.
+    fn fill(&self, text: &str) -> Option<String> {
+        'next: for t in &self.templates {
+            let (first, last) = (&t.pieces[0], &t.pieces[t.pieces.len() - 1]);
+            if !text.starts_with(first.as_str()) || !text.ends_with(last.as_str()) || text.len() < first.len() + last.len() {
+                continue;
+            }
+            let body = &text[first.len()..text.len() - last.len()];
+            let mut values = Vec::with_capacity(t.names.len());
+            let mut rest = body;
+            for piece in &t.pieces[1..t.pieces.len() - 1] {
+                let Some(at) = rest.find(piece.as_str()).filter(|&at| at > 0) else { continue 'next };
+                values.push(&rest[..at]);
+                rest = &rest[at + piece.len()..];
+            }
+            if rest.is_empty() {
+                continue;
+            }
+            values.push(rest);
+            // A value is a name, a number or a short phrase: a whole English sentence caught
+            // between two common words (`{a} and {b}`) is not this template.
+            if values.iter().any(|v| v.split_whitespace().count() > 4) {
+                continue;
+            }
+            let mut out = t.shown.clone();
+            for (name, value) in t.names.iter().zip(values) {
+                let value = self.shown.get(value).map_or(value, |v| v);
+                out = out.replacen(&format!("{{{name}}}"), value, 1);
+            }
+            return Some(out);
+        }
+        None
+    }
+}
+
+fn table(index: usize) -> &'static Table {
+    static TABLES: [OnceLock<Table>; 2] = [OnceLock::new(), OnceLock::new()];
+    TABLES[index].get_or_init(|| Table::load(&LANGUAGES[index]))
+}
+
+/// Index into [`LANGUAGES`] of the interface language.
+static CURRENT: AtomicUsize = AtomicUsize::new(0);
+
+/// The interface language.
+pub fn current() -> &'static Lang {
+    &LANGUAGES[CURRENT.load(Ordering::Relaxed)]
+}
+
+/// Is the interface laid out right to left?
+pub fn is_rtl() -> bool {
+    current().is_rtl()
+}
+
+/// A language by its code (any case).
+pub fn from_code(code: &str) -> Option<usize> {
+    LANGUAGES.iter().position(|l| l.code.eq_ignore_ascii_case(code))
+}
+
+/// The registered language for a locale tag such as `ar_SA.UTF-8` or `en-GB`.
+pub fn from_tag(tag: &str) -> Option<usize> {
+    let base = tag.split(['.', '@']).next().unwrap_or("").replace('_', "-").to_ascii_lowercase();
+    let primary = base.split('-').next().unwrap_or("");
+    if matches!(primary, "c" | "posix") {
+        return Some(0);
+    }
+    from_code(&base).or_else(|| from_code(primary))
+}
+
+/// The system's language when there is a catalog for it, else English (looked up once).
+pub fn system() -> usize {
+    static SYSTEM: OnceLock<usize> = OnceLock::new();
+    *SYSTEM.get_or_init(|| {
+        // Tests drive the interface by its English labels whatever the machine's language is.
+        if cfg!(test) {
+            return 0;
+        }
+        if let Some(l) = std::env::var("DECKCRAFT_LANGUAGE").ok().and_then(|v| from_tag(&v)) {
+            return l;
+        }
+        sys_locale::get_locales().take(16).find_map(|t| from_tag(&t)).unwrap_or(0)
+    })
+}
+
+/// Show the interface in the language the `language` setting names (`auto` follows the system).
+pub fn apply(pref: &str) {
+    let index = if pref.eq_ignore_ascii_case(AUTO) { system() } else { from_code(pref).unwrap_or_else(system) };
+    if CURRENT.swap(index, Ordering::Relaxed) == index && TRANSLATING.load(Ordering::Relaxed) == index {
+        return;
+    }
+    TRANSLATING.store(index, Ordering::Relaxed);
+    if let Ok(mut memo) = MEMO.lock() {
+        *memo = None;
+    }
+    egui::epaint::text::set_ui_translator(if index == 0 { None } else { Some(translate) });
+}
+
+/// The language whose translator is installed.
+static TRANSLATING: AtomicUsize = AtomicUsize::new(0);
+
+/// Template results already worked out (text → shown text); emptied when it grows large.
+static MEMO: Mutex<Option<HashMap<String, Option<Arc<str>>>>> = Mutex::new(None);
+
+/// The layout hook: `text` as shown in the interface language, or `None` to keep it.
+fn translate(text: &str) -> Option<Arc<str>> {
+    let t = table(CURRENT.load(Ordering::Relaxed));
+    // Already translated text, numbers and symbols stay as they are.
+    if !text.bytes().any(|b| b.is_ascii_alphabetic()) {
+        return None;
+    }
+    if let Some(shown) = t.shown.get(text) {
+        return Some(shown.clone());
+    }
+    if t.templates.is_empty() {
+        return None;
+    }
+    let mut memo = MEMO.lock().ok()?;
+    let memo = memo.get_or_insert_with(HashMap::new);
+    if let Some(hit) = memo.get(text) {
+        return hit.clone();
+    }
+    if memo.len() > 4096 {
+        memo.clear();
+    }
+    let shown = t.fill(text).map(Arc::from);
+    memo.insert(text.to_string(), shown.clone());
+    shown
+}
+
+/// `text` in the interface language, in display order (English when there is no entry).
+pub fn t(text: &str) -> String {
+    let t = table(CURRENT.load(Ordering::Relaxed));
+    t.shown.get(text).map_or_else(|| text.to_string(), |s| s.to_string())
+}
+
+/// A ribbon button's label in the interface language, split into its (at most two) rows by
+/// `wrap`: a right-to-left translation is wrapped as written and then each row is put in
+/// display order, so the rows read top to bottom.
+pub fn label_rows(label: &str, wrap: impl Fn(&str) -> Vec<&str>) -> Vec<String> {
+    label_rows_in(CURRENT.load(Ordering::Relaxed), label, wrap)
+}
+
+/// [`label_rows`] in the language at `index` of [`LANGUAGES`].
+fn label_rows_in(index: usize, label: &str, wrap: impl Fn(&str) -> Vec<&str>) -> Vec<String> {
+    let t = table(index);
+    match t.logical.get(label) {
+        Some(logical) if t.rtl => wrap(logical).into_iter().map(rtl::display_order).collect(),
+        Some(_) => wrap(&t.shown[label]).into_iter().map(str::to_string).collect(),
+        None => wrap(label).into_iter().map(str::to_string).collect(),
+    }
+}
+
+#[cfg(test)]
+mod tests;
