diff --git a/crates/ui-egui/src/i18n/rtl.rs b/crates/ui-egui/src/i18n/rtl.rs
new file mode 100644
index 0000000..fbd3362
--- /dev/null
+++ b/crates/ui-egui/src/i18n/rtl.rs
@@ -0,0 +1,169 @@
+//! Right-to-left catalogs (Arabic). egui lays a line out left to right: it shapes each run of an
+//! Arabic face right to left (letters join and read correctly), but places the runs, the spaces
+//! between words and any punctuation in the order they come. A translation is therefore stored
+//! in display order once, when its catalog loads: the Unicode bidi algorithm orders the line,
+//! and inside a right-to-left run every Arabic word stays as written (egui shapes it) while the
+//! words, spaces and punctuation around them are reversed and brackets mirrored.
+//!
+//! `{name}` placeholders are kept whole (they are filled after the lookup), and so are numbers
+//! and Latin words, which read left to right. A label that egui wraps onto several rows keeps
+//! its words but reads the rows bottom to top; the interface's labels are short.
+
+use unicode_bidi::{BidiClass, BidiInfo, Level, bidi_class};
+
+/// Is `c` written right to left (Arabic, Hebrew, Syriac, Thaana, N'Ko …)?
+pub fn is_rtl_char(c: char) -> bool {
+    matches!(bidi_class(c), BidiClass::R | BidiClass::AL)
+}
+
+/// Does `c` belong to an Arabic-script run egui shapes as one piece: the letters, their marks
+/// and the Arabic punctuation and digits drawn from the Arabic face?
+fn shaped_with_word(c: char) -> bool {
+    matches!(c,
+        '\u{0600}'..='\u{06FF}' // Arabic
+        | '\u{0750}'..='\u{077F}' // Arabic Supplement
+        | '\u{0870}'..='\u{08FF}' // Arabic Extended-B and -A
+        | '\u{FB50}'..='\u{FDFF}' // Arabic Presentation Forms-A
+        | '\u{FE70}'..='\u{FEFF}' // Arabic Presentation Forms-B
+        | '\u{200C}' | '\u{200D}' // ZWNJ, ZWJ
+    ) && c != '\u{061C}' // ARABIC LETTER MARK: a direction mark, not drawn
+}
+
+/// `c` as drawn in a right-to-left run: brackets face the other way, since egui draws the
+/// character it is given.
+fn mirrored(c: char) -> char {
+    match c {
+        '(' => ')',
+        ')' => '(',
+        '[' => ']',
+        ']' => '[',
+        '{' => '}',
+        '}' => '{',
+        '<' => '>',
+        '>' => '<',
+        '«' => '»',
+        '»' => '«',
+        '‹' => '›',
+        '›' => '‹',
+        _ => c,
+    }
+}
+
+/// Invisible direction marks the bidi pass has used up; egui would draw some as boxes.
+fn is_direction_mark(c: char) -> bool {
+    matches!(c, '\u{200E}' | '\u{200F}' | '\u{061C}' | '\u{202A}'..='\u{202E}' | '\u{2066}'..='\u{2069}')
+}
+
+/// First private-use character standing in for a placeholder while the line is ordered (bidi
+/// class L, so it reads like a Latin word).
+const SLOT: u32 = 0xF0000;
+
+/// `text` in display order for egui, line by line. Text without right-to-left letters comes
+/// back unchanged.
+pub fn display_order(text: &str) -> String {
+    if !text.chars().any(is_rtl_char) {
+        return text.to_string();
+    }
+    text.split('\n').map(display_line).collect::<Vec<_>>().join("\n")
+}
+
+fn display_line(line: &str) -> String {
+    // Hide the placeholders behind single left-to-right characters.
+    let mut names: Vec<&str> = Vec::new();
+    let mut hidden = String::with_capacity(line.len());
+    let mut rest = line;
+    while let Some((before, after_open)) = rest.split_once('{') {
+        let Some((name, after_close)) = after_open.split_once('}') else { break };
+        hidden.push_str(before);
+        hidden.push(char::from_u32(SLOT + names.len() as u32).unwrap_or('\u{FFFD}'));
+        names.push(name);
+        rest = after_close;
+    }
+    hidden.push_str(rest);
+
+    // The interface reads right to left, so every line has a right-to-left base direction.
+    let info = BidiInfo::new(&hidden, Some(Level::rtl()));
+    let mut out = String::with_capacity(hidden.len());
+    for p in &info.paragraphs {
+        if p.range.is_empty() {
+            continue;
+        }
+        let (levels, runs) = info.visual_runs(p, p.range.clone());
+        for run in runs {
+            let rtl = levels.get(run.start).is_some_and(|l| l.is_rtl());
+            // Runs lie on character boundaries; a missing slice is skipped, never a panic.
+            let Some(piece) = hidden.get(run) else { continue };
+            if !rtl {
+                out.push_str(piece);
+                continue;
+            }
+            // Arabic words whole, every other character on its own; then reversed.
+            let mut atoms: Vec<String> = Vec::new();
+            for c in piece.chars() {
+                match atoms.last_mut() {
+                    Some(word) if shaped_with_word(c) && word.chars().last().is_some_and(shaped_with_word) => word.push(c),
+                    _ => atoms.push(if shaped_with_word(c) { c.to_string() } else { mirrored(c).to_string() }),
+                }
+            }
+            atoms.reverse();
+            out.extend(atoms);
+        }
+    }
+
+    // Put the placeholders back and drop the direction marks.
+    let mut shown = String::with_capacity(out.len());
+    for c in out.chars().filter(|c| !is_direction_mark(*c)) {
+        match (c as u32).checked_sub(SLOT).and_then(|i| names.get(i as usize)) {
+            Some(name) => {
+                shown.push('{');
+                shown.push_str(name);
+                shown.push('}');
+            }
+            None => shown.push(c),
+        }
+    }
+    shown
+}
+
+#[cfg(test)]
+mod tests {
+    use super::display_order;
+
+    #[test]
+    fn latin_text_is_unchanged() {
+        assert_eq!(display_order("Insert Table…"), "Insert Table…");
+        assert_eq!(display_order("{n} pt"), "{n} pt");
+    }
+
+    #[test]
+    fn words_are_placed_right_to_left_and_letters_stay_as_written() {
+        assert_eq!(display_order("إدراج جدول"), "جدول إدراج");
+        assert_eq!(display_order("حفظ"), "حفظ");
+    }
+
+    #[test]
+    fn punctuation_ellipsis_and_brackets_sit_on_the_reading_side() {
+        assert_eq!(display_order("العنوان:"), ":العنوان");
+        assert_eq!(display_order("إدراج جدول…"), "…جدول إدراج");
+        // Mirrored, so the opening bracket is drawn facing the text on the right.
+        assert_eq!(display_order("(الكل)"), "(الكل)");
+        assert_eq!(display_order("هل تريد الحفظ؟"), "الحفظ؟ تريد هل");
+    }
+
+    #[test]
+    fn placeholders_numbers_and_latin_words_read_left_to_right() {
+        assert_eq!(display_order("{n} نقطة"), "نقطة {n}");
+        assert_eq!(display_order("الصفحة {page} من {pages}"), "{pages} من {page} الصفحة");
+        assert_eq!(display_order("عنوان 1"), "1 عنوان");
+        assert_eq!(display_order("حول WordCraft"), "WordCraft حول");
+        assert_eq!(display_order("تباعد أسطر 1.5"), "1.5 أسطر تباعد");
+        // A left-to-right mark after a closing bracket keeps it with the Latin text before it.
+        assert_eq!(display_order("مستند Word (*.docx)\u{200E}"), "Word (*.docx) مستند");
+        assert_eq!(display_order("نص {n} من {total}"), "{total} من {n} نص");
+    }
+
+    #[test]
+    fn each_line_of_a_ribbon_label_is_ordered_on_its_own() {
+        assert_eq!(display_order("إدراج\nتسمية توضيحية"), "إدراج\nتوضيحية تسمية");
+    }
+}
