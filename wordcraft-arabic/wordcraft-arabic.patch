+/// Is the interface laid out right to left (an Arabic interface)?
+pub fn rtl() -> bool {
+    crate::i18n::current().is_rtl()
+}
+
+/// `x`, a position inside `rect` worked out for a left-to-right interface, on the side it goes in
+/// the interface's direction: mirrored across `rect` when the interface reads right to left.
+pub fn mirror_x(rect: Rect, x: f32) -> f32 {
+    if rtl() { rect.min.x + rect.max.x - x } else { x }
+}
+
+/// Text anchored at its start: left in a left-to-right interface, right in a right-to-left one.
+pub fn start_align(v: egui::Align) -> Align2 {
+    Align2([if rtl() { egui::Align::RIGHT } else { egui::Align::LEFT }, v])
+}
+
+/// A vertical stack of ribbon controls, lined up on the interface's start side (the right in a
+/// right-to-left interface, where rows inside it also run right to left).
+pub fn column<R>(ui: &mut Ui, add: impl FnOnce(&mut Ui) -> R) -> R {
+    if !rtl() {
+        return ui.vertical(add).inner;
+    }
+    ui.scope_builder(egui::UiBuilder::new().layout(egui::Layout::top_down(egui::Align::Max)), add).inner
+}
+
+/// `add` laid out left to right in a right-to-left ribbon row: a `Grid` (rows of labels and
+/// fields) assumes a left-to-right parent. The block takes the width it took last frame, so it
+/// sits in the row's flow; `id` keys that width.
+pub fn ltr_block(ui: &mut Ui, id: &str, add: impl FnOnce(&mut Ui)) {
+    if !rtl() {
+        add(ui);
+        return;
+    }
+    let key = ui.id().with(("ltr_block", id));
+    let last: f32 = ui.data(|d| d.get_temp(key)).unwrap_or(0.0);
+    let r = ui.allocate_ui_with_layout(vec2(last, ui.available_height()), egui::Layout::left_to_right(egui::Align::Min), |ui| {
+        add(ui);
+        ui.min_rect().width()
+    });
+    if (r.inner - last).abs() > 0.5 {
+        ui.data_mut(|d| d.insert_temp(key, r.inner));
+        ui.ctx().request_repaint();
+    }
+}
